{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["prefix", "matches"],
  "properties": {
    "prefix": {"type": "string", "pattern": "^[0-9A-F]{5}$"},
    "matches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["hash_suffix", "count"],
        "properties": {
          "hash_suffix": {"type": "string"},
          "count": {"type": "integer"}
        }
      }
    },
    "total_count": {"type": ["integer", "null"]}
  }
}
