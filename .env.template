# Environment variables for the cyber-au profile.
# Copy to .env and fill in your own values. No connector key is required.
# The agent works with public sources when these are unset.

# abuse.ch Auth-Key (free at https://auth.abuse.ch/). Needed for URLhaus, ThreatFox, MalwareBazaar.
# (optional)
# ABUSECH_AUTH_KEY=

# Optional NVD API key. Raises NVD limits from 5 to 50 requests per 30 seconds.
# (optional)
# NVD_API_KEY=

# AlienVault OTX API key.
# (optional)
# OTX_API_KEY=

# Cloudflare custom token with Account > Radar > Read only.
# (optional)
# CLOUDFLARE_RADAR_API_TOKEN=

# Optional GreyNoise community key.
# (optional)
# GREYNOISE_API_KEY=

# Paid, bring your own licence. Premium servers stay off until you set enabled: true.
# HUDSONROCK_API_KEY=
# SPYCLOUD_API_KEY=
# UPGUARD_API_KEY=
# RECORDED_FUTURE_API_TOKEN=
# FLASHPOINT_API_TOKEN=
# INTEL471_EMAIL=
# INTEL471_API_KEY=
# GTI_API_KEY=
# FALCON_CLIENT_ID=
# FALCON_CLIENT_SECRET=
# SOCRADAR_API_KEY=
# SOCRADAR_COMPANY_ID=
# DARKOWL_PUBLIC_KEY=
# DARKOWL_PRIVATE_KEY=
# FLARE_API_KEY=

# (optional) Paid, bring your own licence.
# RECORDED_FUTURE_ORG_ID=
# RECORDED_FUTURE_MCP_CLIENT_ID=
# RECORDED_FUTURE_MCP_CLIENT_SECRET=
# FALCON_BASE_URL=
# FLARE_TENANT_ID=

# (optional) Free key for the ransomware.live PRO API. The feed stays off until you enable it.
# RANSOMWARE_LIVE_API_KEY=
