{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "domains": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "hostname"
      },
      "minItems": 1,
      "maxItems": 50,
      "description": "Must all be on the user's org-exposure watchlist unless `allow_external` is set by the user"
    },
    "types": {
      "type": "array",
      "items": {
        "enum": [
          "employees",
          "users",
          "third_parties"
        ]
      }
    },
    "since": {
      "type": "string",
      "format": "date",
      "description": "YYYY-MM-DD, Australia/Sydney"
    }
  },
  "required": [
    "domains"
  ]
}
