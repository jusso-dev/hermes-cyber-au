                "maxLength": 256,
                "type": "string"
              },
              "operation": {
                "maxLength": 512,
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "operation"
            ],
            "type": "object"
          },
          "name": "junction_permissions"
