    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uuid",
        "info",
        "date",
        "distribution",
        "published",
        "timestamp",
        "Orgc",
        "Attribute"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "orgc_id": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "org_id": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "uuid": {
          "$ref": "#/$defs/uuid"
        },
        "info": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\n\\r]*$"
        },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "threat_level_id": {
          "enum": [
            "1",
            "2",
            "3",
            "4"
          ]
        },
        "analysis": {
          "enum": [
            "0",
            "1",
            "2"
          ]
        },
        "distribution": {
          "enum": [
            "0",
            "1",
            "2",
            "3",
            "4"
          ]
        },
        "sharing_group_id": {
