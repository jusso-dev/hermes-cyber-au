              },
              "limit": {
                "maximum": 100,
                "minimum": 1,
                "type": "integer"
              },
              "product": {
                "maxLength": 128,
                "type": "string"
              },
              "query": {
                "maxLength": 1024,
                "type": "string"
              },
              "service": {
                "maxLength": 128,
                "type": "string"
              }
            },
            "required": [
              "query"
            ],
            "type": "object"
          },
          "name": "junction_search"
        },
        {
          "annotations": {
            "destructiveHint": false,
            "openWorldHint": true,
            "readOnlyHint": true
          },
