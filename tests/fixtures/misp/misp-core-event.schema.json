          "pattern": "^[0-9]+$"
        },
        "published": {
          "type": "boolean"
        },
        "timestamp": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "publish_timestamp": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "attribute_count": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "extends_uuid": {
          "type": "string"
        },
        "Orgc": {
          "$ref": "#/$defs/org"
        },
        "Org": {
          "$ref": "#/$defs/org"
        },
        "Tag": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/tag"
          }
        },
        "Attribute": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/attribute"
          }
