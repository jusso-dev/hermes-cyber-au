        "event_id": {
          "type": "string"
        },
        "object_id": {
          "type": "string"
        },
        "sharing_group_id": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "comment": {
          "type": "string"
        },
        "deleted": {
          "type": "boolean"
        },
        "disable_correlation": {
          "type": "boolean"
