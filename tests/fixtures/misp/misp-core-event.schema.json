        "id": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "uuid": {
          "$ref": "#/$defs/uuid"
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "enum": [
            "Antivirus detection",
            "Artifacts dropped",
            "Attribution",
            "External analysis",
            "Financial fraud",
            "Internal reference",
            "Network activity",
            "Other",
            "Payload delivery",
            "Payload installation",
            "Payload type",
            "Persistence mechanism",
            "Person",
            "Social network",
            "Support Tool",
            "Targeting data"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "to_ids": {
          "type": "boolean"
        },
        "distribution": {
          "enum": [
            "0",
            "1",
            "2",
            "3",
            "4",
            "5"
