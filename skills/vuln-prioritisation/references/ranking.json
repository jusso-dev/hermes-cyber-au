{
  "version": "0.1.0",
  "batch_size": 100,
  "rules": [
    {"id": "kev-member", "tier": 1, "when": "kev"},
    {"id": "au-alert", "tier": 1, "when": "au_mention"},
    {"id": "epss-high", "tier": 1, "when": {"epss_gte": "0.7"}},
