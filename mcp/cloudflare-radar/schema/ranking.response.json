{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "success",
    "result"
  ],
  "properties": {
    "success": {
      "const": true
    },
    "result": {
      "type": "object",
      "required": [
        "top_0"
      ],
      "properties": {
        "top_0": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "rank",
              "domain"
            ],
            "properties": {
              "rank": {
                "type": "integer"
              },
              "domain": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
