# Environment for the watcher profile.
# Copy the lines you need into .env. No connector key value is shipped.
# The watcher is the only profile that names connector keys.

# ABUSECH_AUTH_KEY=
# NVD_API_KEY=
# OTX_API_KEY=
# CLOUDFLARE_RADAR_API_TOKEN=
# GREYNOISE_API_KEY=

# Optional base URL of your own Hindsight server. The client stays off until this is set.
# No host is shipped.
# HINDSIGHT_BASE_URL=

# Optional API key for that server. No key is shipped.
# HINDSIGHT_API_KEY=

CYBERAU_PROFILE_ROLE=watcher
