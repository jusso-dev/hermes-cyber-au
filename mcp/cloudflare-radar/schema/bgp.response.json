{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "success",
    "result"
  ],
  "properties": {
    "success": {
      "const": true
    },
    "result": {
      "type": "object",
      "required": [
        "events"
      ],
      "properties": {
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "prefixes"
            ],
            "properties": {
              "id": {
                "type": "integer"
              },
              "hijackerAsn": {
                "type": "integer"
              },
              "victimAsns": {
                "type": "array"
              },
              "prefixes": {
                "type": "array"
              }
            }
          }
        }
      }
    }
  }
}
