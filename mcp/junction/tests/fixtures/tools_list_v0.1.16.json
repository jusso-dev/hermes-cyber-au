                "minimum": 1,
                "type": "integer"
              },
              "operation": {
                "maxLength": 512,
                "minLength": 1,
                "type": "string"
              },
              "timeout_seconds": {
                "maximum": 3600,
                "minimum": 1,
                "type": "integer"
              },
              "wait": {
                "type": "boolean"
              }
            },
            "required": [
              "operation",
              "input"
            ],
            "type": "object"
          },
          "name": "junction_execute"
        },
        {
          "annotations": {
            "destructiveHint": true,
            "openWorldHint": true,
            "readOnlyHint": false
          },
