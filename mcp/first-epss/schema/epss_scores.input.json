{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "cve_ids": {
      "type": "array",
      "items": {"type": "string", "pattern": "^CVE-\\d{4}-\\d{4,}$"},
      "minItems": 1,
      "maxItems": 100
    },
    "date": {"type": "string", "format": "date"}
  },
  "required": ["cve_ids"]
}
