# Environment variables for the cyber-au profile.
# Copy to .env and fill in your own values. No connector key is required.
# The agent works with public sources when these are unset.
# Never commit a filled-in copy. Every name a server reads in
# mcp/servers.yaml must appear here; tools/build_connector_docs.py --check
# fails in CI when one is missing.

# ---------------------------------------------------------------------------
# Free or optional keys for public sources
# ---------------------------------------------------------------------------

# abuse.ch Auth-Key (free at https://auth.abuse.ch/). Needed for URLhaus, ThreatFox, MalwareBazaar.
# ABUSECH_AUTH_KEY=

# AbuseIPDB API key (free tier). Needed for IP and network reputation checks.
# ABUSEIPDB_API_KEY=

# Optional NVD API key. Raises NVD limits from 5 to 50 requests per 30 seconds.
# NVD_API_KEY=

# AlienVault OTX API key (free).
# OTX_API_KEY=

# Optional GreyNoise community key.
# GREYNOISE_API_KEY=

# Cloudflare custom token with Account > Radar > Read only.
# CLOUDFLARE_RADAR_API_TOKEN=

# Cloudflare URL Scanner token (Account > URL Scanner > Edit) and your account id.
# Submits are Unlisted and need approval. The cfscan server is off by default.
# CLOUDFLARE_URLSCAN_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# Optional GitHub token. Raises the GitHub API limit from 60 to 5,000 requests
# an hour for the ISM and Sigma connectors.
# GITHUB_TOKEN=

# Fine-grained GitHub token with no repository permissions, for the GitHub
# Advisory Database (ghsa). The server returns no data without it.
# GITHUB_ADVISORY_TOKEN=

# Have I Been Pwned key (paid subscription, scope hibp.mcp). Breach metadata
# works without it; account and domain lookups need it and CYBERAU_APPROVAL_KEY.
# HIBP_API_KEY=

# Optional PhishTank application key. Without it PhishTank allows only a few
# database downloads a day.
# PHISHTANK_APP_KEY=

# Optional free ransomware.live PRO key (https://www.ransomware.live/my).
# Without it the connector uses the public v2 API and filters to Australia locally.
# The connector ships disabled. Turn it on in config.yaml after you accept the terms.
# RANSOMWARE_LIVE_API_KEY=

# Your own VirusTotal AI token (https://ai.virustotal.com/connect/mcp).
# The virustotal server is off by default because of the licence terms.
# VTAI_TOKEN=

# Optional ABN Lookup web services GUID (free registration). Expands watchlist
# ABNs to registered and business names. The ABN itself is not sent to vendors.
# ABR_GUID=

# ---------------------------------------------------------------------------
# Approval key for human-approved lookups
# ---------------------------------------------------------------------------

# Random secret used to sign and check approval tokens for personal-information
# lookups (HIBP breached-account and breached-domain). With no value set, those
# calls are always blocked. It is not a vendor key. Create one without printing
# it, in the profile .env (default ~/.hermes/profiles/cyber-au/.env):
#   printf 'CYBERAU_APPROVAL_KEY=%s\n' "$(python3 -c 'import secrets; print(secrets.token_hex(32))')" >> ~/.hermes/profiles/cyber-au/.env
# CYBERAU_APPROVAL_KEY=

# ---------------------------------------------------------------------------
# Your own instance. Off until you enable the connector in config.yaml.
# ---------------------------------------------------------------------------

# OpenCTI instance URL and a read-only API token.
# OPENCTI_URL=
# OPENCTI_TOKEN=

# MISP instance URL (including AusMISP) and a read-only API key.
# MISP_URL=
# MISP_API_KEY=

# TAXII 2.1 API root, collection id, and HTTP Basic username and password.
# Leave unset unless you bring your own access, for example ASD CTIS.
# TAXII_API_ROOT=
# TAXII_COLLECTION_ID=
# TAXII_USERNAME=
# TAXII_PASSWORD=

# Optional ThreatSieve origin. Defaults to http://127.0.0.1:8787 when unset.
# THREATSIEVE_URL=
# Optional ThreatSieve scoped API key. Sent as Authorization Bearer. Never logged.
# THREATSIEVE_API_KEY=

# Optional base URL of your own Hindsight server. The client stays off until
# this is set. No host is shipped.
# HINDSIGHT_BASE_URL=
# Optional API key for that server. No key is shipped.
# HINDSIGHT_API_KEY=

# ---------------------------------------------------------------------------
# Premium feeds. Paid, bring your own licence. Each server stays off until you
# set enabled: true for it. See docs/premium/README.md.
# ---------------------------------------------------------------------------

# Hudson Rock Cavalier API key.
# HUDSONROCK_API_KEY=

# SpyCloud API key.
# SPYCLOUD_API_KEY=

# UpGuard API key with read permissions only.
# UPGUARD_API_KEY=

# Recorded Future API token. The org id is optional, for tokens that cover
# more than one organisation. The MCP client id and secret are for the
# official Recorded Future MCP server.
# RECORDED_FUTURE_API_TOKEN=
# RECORDED_FUTURE_ORG_ID=
# RECORDED_FUTURE_MCP_CLIENT_ID=
# RECORDED_FUTURE_MCP_CLIENT_SECRET=

# Flashpoint Ignite API token.
# FLASHPOINT_API_TOKEN=

# Intel 471 account email and API key (HTTP Basic).
# INTEL471_EMAIL=
# INTEL471_API_KEY=

# Google Threat Intelligence (DTM) API key. Do not reuse a VirusTotal Public API key.
# GTI_API_KEY=

# CrowdStrike Falcon API client id and secret. The base URL is optional.
# FALCON_CLIENT_ID=
# FALCON_CLIENT_SECRET=
# FALCON_BASE_URL=

# SOCRadar company API key and numeric company id.
# SOCRADAR_API_KEY=
# SOCRADAR_COMPANY_ID=

# DarkOwl public and private API keys.
# DARKOWL_PUBLIC_KEY=
# DARKOWL_PRIVATE_KEY=

# Flare API key. The tenant id is optional.
# FLARE_API_KEY=
# FLARE_TENANT_ID=
