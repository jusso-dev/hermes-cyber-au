  "additionalProperties": false,
  "required": [
    "Event"
  ],
  "properties": {
    "Event": {
      "$ref": "#/$defs/event"
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "tag": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "colour": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "exportable": {
          "type": "boolean"
        },
        "hide_tag": {
          "type": "boolean"
        },
        "user_id": {
          "type": "string"
        }
      }
    },
    "org": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uuid",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "uuid": {
          "$ref": "#/$defs/uuid"
        }
      }
    },
