      {
        "title": "Guidelines for cyber security documentation / System-specific cyber security documentation / Cyber security incident response plan",
        "controls": [
          {
            "id": "ism-0043",
            "class": "ISM-control",
            "title": "Control: ism-0043",
            "props": [
              {
                "name": "sort-id",
                "value": "catalog[1].group[06].group[2].group[2].control[1]"
              },
              {
                "name": "revision",
