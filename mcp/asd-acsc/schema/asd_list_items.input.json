{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "feeds": {
      "type": "array",
      "items": {
        "enum": ["alerts", "advisories", "publications", "threats", "news"]
      },
      "default": ["alerts", "advisories"]
    },
    "since": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "YYYY-MM-DD, interpreted in Australia/Sydney"
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "default": 20
    }
  },
  "required": []
}
