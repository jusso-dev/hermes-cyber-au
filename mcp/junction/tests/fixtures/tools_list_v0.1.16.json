                "minimum": 1,
                "type": "integer"
              },
              "operations": {
                "items": {
                  "type": "object"
                },
                "maxItems": 100,
                "minItems": 1,
                "type": "array"
              },
              "timeout_seconds": {
                "maximum": 3600,
                "minimum": 1,
                "type": "integer"
              }
            },
            "required": [
              "operations"
            ],
            "type": "object"
          },
          "name": "junction_batch"
        },
        {
          "annotations": {
            "destructiveHint": false,
            "openWorldHint": true,
            "readOnlyHint": true
          },
